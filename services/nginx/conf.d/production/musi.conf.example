# MUSI Production Server Configuration
# 複製此文件並移除 .example 擴展: cp musi.conf.example musi.conf

upstream php_backend {
    server php-fpm:9000;
}

server {
    listen 80;
    listen [::]:80;

    # 配置您的域名
    server_name musi.example.com www.musi.example.com;

    # 重定向到 HTTPS (生產環境建議使用)
    # return 301 https://$server_name$request_uri;

    root /www;
    index index.php index.html index.htm;

    # 日誌配置
    access_log /var/log/nginx/musi_access.log;
    error_log /var/log/nginx/musi_error.log warn;

    # 隱藏 Nginx 版本號 (安全最佳實踐)
    server_tokens off;

    # 增加客戶端上傳限制
    client_max_body_size 100M;

    # 靜態文件緩存
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 拒絕訪問隱藏文件
    location ~ /\. {
        deny all;
    }

    # 排除某些路徑不轉發到 PHP
    location ~ ^/(storage|vendor|config|bootstrap|app/storage|app/bootstrap) {
        deny all;
    }

    # PHP 文件處理
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass php_backend;
        fastcgi_index index.php;

        # 引入標準的 FastCGI 配置
        include fastcgi-php.conf;
        include fastcgi_params;

        # 傳遞必要的變量給 PHP
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        # 性能優化
        fastcgi_buffering on;
        fastcgi_buffer_size 4k;
        fastcgi_buffers 8 4k;
        fastcgi_busy_buffers_size 8k;

        # 超時設置
        fastcgi_connect_timeout 60s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 60s;
    }

    # 主站點路由 (Laravel/Symfony 等框架)
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 健康檢查端點 (用於負載均衡器)
    location /health {
        access_log off;
        return 200 "healthy";
        add_header Content-Type text/plain;
    }
}

